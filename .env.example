# =====================================================================
#  Friday - configuration file
#  Copy this file to ".env" (the installer does this for you) and fill in
#  your API key. NEVER share your .env file or post it online.
# =====================================================================

# ---------------- LLM "brain" ----------------
# Which provider to use: abacus | openai | anthropic | custom
LLM_PROVIDER=abacus

# --- Abacus.AI RouteLLM (default; included with Abacus.AI ChatLLM / Pro) ---
# Get your key at: https://abacus.ai/app/route-llm-apis
# (or in ChatLLM click the "RouteLLM API" icon in the lower-left corner)
ABACUS_API_KEY=your-abacus-routellm-key-here
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
# "route-llm" lets Abacus pick the best model automatically. You can also
# use a specific model name shown on the RouteLLM API page, e.g. gpt-4.1-mini
ABACUS_MODEL=route-llm

# --- OpenAI (optional) --- https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (optional) --- https://console.anthropic.com/settings/keys
# Note: a Claude Code / Claude.ai subscription is NOT an API key; the API is billed separately.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Local AI (Ollama / LM Studio) or any OpenAI-compatible server (FreeLLMAPI etc.) ---
# Ollama on this PC: http://localhost:11434/v1   FreeLLMAPI: http://localhost:3001/v1 (model: auto)
# setup_local_ai.bat fills these in for you.
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=not-needed
CUSTOM_MODEL=qwen2.5:7b

# ---------------- Backup "big brain" (saves credits) ----------------
# Main brain = LLM_PROVIDER above (e.g. custom = free local AI). The backup is only used when:
#   - you say one of ESCALATE_PHRASES ("think hard", "big brain", "ask abacus"...)
#   - the main AI is down / errors / gets stuck (ESCALATE_ON_ERROR)
#   - the main AI itself decides the request is too hard (SELF_ESCALATE)
# BACKUP_PROVIDER: none | abacus | openai | anthropic | custom  (uses that provider's key/model above)
BACKUP_PROVIDER=none
# Not used when the backup brain is Abacus (Abacus has no limit in Friday).
BACKUP_MAX_PER_DAY=25
ESCALATE_ON_ERROR=true
SELF_ESCALATE=true
ESCALATE_PHRASES=think hard,big brain,use the big brain,ask abacus,use abacus,go deep

# Tool calling mode: auto | native | json
#   auto   = try native function calling, fall back to JSON mode if the model refuses
#   json   = always use the text/JSON protocol (works with almost any model)
TOOL_MODE=auto

# ---------------- Email skill (optional) ----------------
# Lets Friday check / read / search your email (read-only) and send or reply (always asks first).
# EMAIL_PROVIDER: gmail (also Google Workspace business email) | outlook | yahoo | icloud | custom
# Gmail/Workspace: create an APP PASSWORD at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
EMAIL_PROVIDER=gmail
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
# Only for EMAIL_PROVIDER=custom:
EMAIL_IMAP_SERVER=
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=465

# ---------------- Assistant ----------------
ASSISTANT_NAME=Friday
USER_NAME=Ibbi
# Comma-separated wake words. Any of these phrases wakes the assistant.
WAKE_WORDS=hey friday,friday,jarvis,hey jarvis

# Input mode: always | wake | ptt | text
#   always = listening all the time. Say the wake word anywhere in a sentence;
#            then keep talking for FOLLOWUP_SECONDS without repeating it.
#   wake   = needs the wake word every time (no follow-up window)
#   ptt    = push-to-talk: press ENTER (or the hotkey below) and then speak
#   text   = type to chat, replies are still spoken (set TTS_ENGINE=none to mute)
INPUT_MODE=always
# Seconds after Friday answers during which you can talk without the wake word
FOLLOWUP_SECONDS=20
# true = answer EVERYTHING she hears (no wake word at all). Handy when alone.
CONVERSATION_MODE=false
# Optional global hotkeys (work even when the window is not focused)
PTT_HOTKEY=ctrl+alt+f
# Mute / unmute the microphone
MUTE_HOTKEY=ctrl+alt+m
# Stop Friday talking
STOP_HOTKEY=ctrl+alt+s

# ---------------- Speech-to-text ----------------
# whisper = offline, private (faster-whisper; downloads a model on first run)
# google  = free online Google recognizer (no key, needs internet)
STT_ENGINE=whisper
# tiny.en (fastest) | base.en (good default) | small.en (more accurate, slower)
WHISPER_MODEL=base.en
# Microphone: leave blank for Windows default, or a device index / part of its name
MIC_DEVICE=
# Voice detection sensitivity. 0 = automatic (measures room noise at startup).
# If it triggers on background noise, set a fixed value like 0.02 (higher = less sensitive).
ENERGY_THRESHOLD=0
SILENCE_SECONDS=1.0
MAX_RECORD_SECONDS=15

# ---------------- Text-to-speech ----------------
# edge   = natural Microsoft neural voices (free, needs internet)
# pyttsx3 = offline Windows voices (robotic but always works)
# none   = no voice, text only
TTS_ENGINE=edge
# Jarvis-like British male: en-GB-RyanNeural   |  Female "Friday": en-IE-EmilyNeural or en-GB-SoniaNeural
EDGE_VOICE=en-GB-RyanNeural
EDGE_RATE=+5%
PYTTSX3_RATE=185

# ---------------- Misc ----------------
# City used for weather when you don't say one
DEFAULT_CITY=Toronto
# Show a system-tray icon with status colours
TRAY_ICON=true
# How many past messages to keep in memory
MEMORY_MAX_MESSAGES=40
# Allow the assistant to run shell commands (always asks for confirmation)
ALLOW_SHELL=true
# Comma-separated tool names to switch off (easier: use the dashboard > Tools tab)
DISABLED_TOOLS=

# ---------------- Dashboard ----------------
# Local web dashboard (only reachable from this PC) with settings, agents,
# status checks (AI connection, Abacus credits, mic, voice...) and live log.
DASHBOARD=true
DASHBOARD_PORT=8765
# Open the dashboard in your browser when Friday starts
DASHBOARD_OPEN_BROWSER=true
# Re-run status checks automatically every N minutes (0 = only when you click)
AUTO_CHECK_MINUTES=10

# ---- v2.0 (all editable in Dashboard > Settings) ----
# Abacus has NO limit in Friday: no cap and no question. Friday only warns each time Abacus use passes another N credits
# (0 = never warn). Set a real limit on abacus.ai if you want one.
ABACUS_WARN_EVERY=1000
# The caps below apply to Claude and other capped cloud AIs only.
CREDIT_DAILY_CAP=200
CREDIT_MONTHLY_CAP=2000
# Credits per day Friday may spend without asking (0 = always ask). Counts real spend. Claude always asks anyway.
CREDIT_PREAPPROVED_PER_DAY=0
AUTONOMY_LEVEL=1
SMS_ENABLED=false
QUO_API_KEY=
FRIDAY_SMS_NUMBER=
OWNER_PHONE=
SMS_PIN=
LOCAL_CODER_MODEL=
VISION_MODEL=qwen2.5vl:7b
EMBED_MODEL=nomic-embed-text
WHISPER_DEVICE=auto
SHOP_NAME=Integrity Powersports
LABOUR_RATE=0
TAX_RATE=13
BRIEFING_TIME=07:30
BRIEFING_SMS=true
NIGHTLY_TIME=02:00
FRIDAY_API_KEY=
REMOTE_ACCESS=false
API_PORT=8766
BACKUP_KEEP=14

# Read links and search the web automatically before answering, so small local AIs can't make things up (on | off)
WEB_PREFETCH=on

# Seconds to wait for the AI to answer (a big local model can take a while to load the first time)
AI_TIMEOUT_SECONDS=240

# Print every step Jarvis thinks (heard / rules / plan / tools / answer) in this window (true | false)
TRACE_CONSOLE=true

# Talk over Jarvis to interrupt it while it is speaking (true | false). Best with a headset; with speakers raise the level.
BARGE_IN=true
# Start talking while the AI is still writing its answer (true | false). Much faster on long replies.
STREAM_VOICE=true

# Claude as the online brains (needs ANTHROPIC_API_KEY above). Haiku = cheap everyday, Sonnet = hard questions/code,
# Opus = only when you ask for it by name ("use Opus"). Each call is still approved through the Credit Gate,
# and each tier has a daily cap. "go online" / "go local" / "back to auto" switch the mode by voice.
CLAUDE_TIERS=true
CLAUDE_MODEL_HAIKU=claude-haiku-5-5
CLAUDE_MODEL_SONNET=claude-sonnet-5-5
CLAUDE_MODEL_OPUS=claude-opus-5-5
CLAUDE_MAX_HAIKU_PER_DAY=40
CLAUDE_MAX_SONNET_PER_DAY=12
CLAUDE_MAX_OPUS_PER_DAY=3
CLAUDE_AUTO_OPUS=false
# Hard stop for the whole month, all Claude tiers together (on top of the daily caps above).
CLAUDE_MAX_CALLS_PER_MONTH=600
# Evening digest: what Jarvis did today, credits and Claude used, anything that failed. Phone notification by default.
# Stop listening at a short (0.5 s) pause when the sentence so far is finished, instead of waiting a full second.
SMART_ENDPOINT=true
DIGEST_ENABLED=true
DIGEST_TIME=20:00
DIGEST_SMS=false

# Optional: your Google/Outlook calendar, read-only, through its private ICS address (keep it secret).
# Google: Calendar settings > your calendar > Integrate calendar > "Secret address in iCal format".
CALENDAR_ICS_URL=
BARGE_IN_LEVEL=0.06

# Preload the local AI at startup and keep it in memory (true | false); how long Ollama keeps it loaded
WARMUP=true
OLLAMA_KEEP_ALIVE=24h
# Reuse the same web page / search for this many seconds (0 = off)
WEB_CACHE_SECONDS=300
# Extra words the microphone should recognise (comma separated), e.g. names of parts or customers
STT_VOCAB=

# ---------------- Free cloud tier (OmniRoute) ----------------
# OmniRoute (npm i -g omniroute, then run 'omniroute') is a local gateway to many FREE AI providers with auto-fallback.
# Order Jarvis uses when the local AI can't handle something:  free cloud -> Abacus (credits) -> Claude (last).
# Copy your key from the OmniRoute dashboard > Endpoints. Leave empty to keep this tier off.
FREE_ROUTER_KEY=
FREE_ROUTER_URL=http://localhost:20128/v1
# auto/cheap = cheapest first (free providers). Connect ONLY free providers in OmniRoute to guarantee $0.
FREE_ROUTER_MODEL=auto/cheap
FREE_ROUTER_MAX_PER_DAY=300
# Brain split: general requests go to the fast free cloud brain, private ones stay local, and reasoning / memory
# questions ("why...", "compare...", "what did we decide...") go to Abacus.
BRAIN_SPLIT=true

# Background projects ("Jarvis, in the background, ..."): how many run at the same time; the rest wait in line.
PROJECTS_MAX_PARALLEL=3

# Updates without being asked: problems, credit warnings and a check-in when something happened. Always pushed to the phone page;
# spoken only at a good moment (not while you talk, not in the quiet hours).
UPDATES_ENABLED=true
UPDATES_SPEAK=true
UPDATES_QUIET_HOURS=22:00-07:00
UPDATES_EVERY_HOURS=4

# Full review: every night the online AI (Abacus) studies everything Jarvis did (every tool, key press, command) and writes
# playbooks for the local AI; each one is tested on the local AI before it is switched on. Friday sets NO credit cap on this:
# set the limit on Abacus itself. Passwords and keys are blanked before anything is saved or sent. Say "review everything" to run it now.
DISTILL_ENABLED=true
DISTILL_MAX_PLAYBOOKS=60
# The record it studies (only what the AI itself does, never your own keystrokes)
BLACKBOX_ENABLED=true
BLACKBOX_KEEP_DAYS=60

# Learn from its mistakes at night: reviews the last 24 h, writes itself new behaviour rules (free; never uses credits)
EVOLVE_ENABLED=true
# EVOLVE_MAX_NEW=4        (new rules per session)
# EVOLVE_MAX_AUTO=20      (self-learned rules kept; rules you taught are never removed)
